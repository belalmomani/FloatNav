<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="شريط التنقل العائم"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="فتح إعدادات خدمة الوصول" />

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اختبار: أظهر الشريط 5 ثوانٍ" />

        <Switch
            android:id="@+id/switchEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="إظهار الشريط" />

        <TextView
            android:id="@+id/tvSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <SeekBar
            android:id="@+id/seekSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvAlpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <SeekBar
            android:id="@+id/seekAlpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvSmart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnPick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تثبيت تطبيق محدد" />

        <Button
            android:id="@+id/btnAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تلقائي (الأكثر استخدامًا)" />

        <TextView
            android:id="@+id/tvUsage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnUsage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="منح إذن إحصاءات الاستخدام" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="• الشريط مثبّت أسفل الشاشة بترتيب عربي (الرجوع على اليمين)، ويختفي فقط أثناء فتح هذا التطبيق.\n• عند ظهور لوحة المفاتيح يتحول الشريط إلى زر عائم قابل للسحب؛ اضغطه لإظهار الأزرار فوق لوحة المفاتيح.
• ضغطة مطوّلة على زر التطبيقات الحديثة: التبديل إلى آخر تطبيق (يعتمد على الجهاز).
• ضغطة مطوّلة على الزر الذكي: فتح هذه الإعدادات.
• على أندرويد 13+ عند التثبيت من خارج المتجر، قد يكون خيار الوصول معطّلاً: من معلومات التطبيق ← ⋮ ← السماح بالإعدادات المقيّدة."
            android:textColor="#555555"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
